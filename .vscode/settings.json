{
  // Treat Arduino / LVGL config / embedded headers correctly.
  "files.associations": {
    "*.ino": "cpp",
    "*.ipp": "cpp",
    "*.tpp": "cpp",
    "lv_conf.h": "c",
    "lvgl.h": "c"
  },

  // Hide build clutter from the explorer. PIO's auto-generated folders are
  // huge and have nothing the user should edit.
  "files.exclude": {
    "**/.pio": true,
    "**/.pioenvs": true,
    "**/.piolibdeps": true,
    "**/.vscode/.browse.c_cpp.db*": true
  },
  "search.exclude": {
    "**/.pio": true,
    "**/.pioenvs": true,
    "**/.piolibdeps": true,
    "**/.vscode/.browse.c_cpp.db*": true
  },

  // Formatting
  "editor.formatOnSave": true,
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.formatting": "clangFormat",

  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[h]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[ino]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },

  // Clean diffs.
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // PlatformIO owns include paths, defines, compiler settings, etc.
  "C_Cpp.default.configurationProvider": "platformio.platformio-ide",
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.errorSquiggles": "enabled"
}
